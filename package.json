{
  "name": "folio-monorepo",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/visual-regression.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm check:boundaries && pnpm check:licenses && pnpm test && pnpm test:visual",
    "build": "pnpm -r --if-present run build",
    "test:distribution": "node scripts/distribution-smoke.mjs",
    "check:release": "pnpm check && pnpm build && pnpm test:distribution"
  },
  "devDependencies": {
    "@abnt/bibliography": "workspace:^",
    "@abnt/cli": "workspace:^",
    "@abnt/compiler": "workspace:^",
    "@abnt/document-model": "workspace:^",
    "@abnt/desktop": "workspace:^",
    "@abnt/editor-codemirror": "workspace:^",
    "@abnt/editor-core": "workspace:^",
    "@abnt/language-service": "workspace:^",
    "@abnt/markdown": "workspace:^",
    "@abnt/plugin-api": "workspace:^",
    "@abnt/plugin-host": "workspace:^",
    "@abnt/protocol": "workspace:^",
    "@abnt/publication": "workspace:^",
    "@abnt/semantics": "workspace:^",
    "@abnt/source-composition": "workspace:^",
    "@abnt/standards": "workspace:^",
    "@abnt/structural-diff": "workspace:^",
    "@abnt/workspace-core": "workspace:^",
    "@abnt/workspace-environment": "workspace:^",
    "@abnt/workspace-graph": "workspace:^",
    "@abnt/workspace-local": "workspace:^",
    "@abnt/workspace-index": "workspace:^",
    "@abnt/workspace-sessions": "workspace:^",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "fast-check": "^4.9.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

                            "column": 35
                          }
                        }
                      }
                    ],
                    "source": {
                      "documentId": "artigo.md",
                      "start": {
                        "offset": 1446,
                        "line": 44,
                        "column": 67
                      },
                      "end": {
                        "offset": 1494,
                        "line": 45,
                        "column": 37
                      }
                    }
                  },
                  {
                    "id": "n15",
                    "type": "text",
                    "value": " é a que define a fronteira transacional.",
                    "source": {

            ],
            "children": [
              {
                "id": "n11",
                "type": "paragraph",
                "children": [
                  {
                    "id": "n12",
                    "type": "text",
                    "value": "Delimitar critérios objetivos para essa escolha, e demonstrar que ",
                    "source": {
                      "documentId": "artigo.md",
                      "start": {
                        "offset": 1380,
                        "line": 44,
                        "column": 1
                      },
                      "end": {
                        "offset": 1446,

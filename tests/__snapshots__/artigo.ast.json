                        "column": 67
                      }
                    }
                  },
                  {
                    "id": "n13",
                    "type": "strong",
                    "children": [
                      {
                        "id": "n14",
                        "type": "text",
                        "value": "a decisão\narquitetural mais cara de reverter",
                        "source": {
                          "documentId": "artigo.md",
                          "start": {
                            "offset": 1448,
                            "line": 44,
                            "column": 69
                          },
                          "end": {
                            "offset": 1492,
